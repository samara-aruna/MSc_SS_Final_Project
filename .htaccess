# Security Headers

# Prevent Clickjacking
Header always set X-Frame-Options "DENY"

# Prevent MIME type sniffing
Header always set X-Content-Type-Options "nosniff"

# Enable XSS Protection
Header always set X-XSS-Protection "1; mode=block"

# Content Security Policy
Header always set Content-Security-Policy "default-src 'self' https://checkout.razorpay.com https://code.jquery.com; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://code.jquery.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com;"

# Hide server information
ServerSignature Off

# Prevent directory browsing
Options -Indexes